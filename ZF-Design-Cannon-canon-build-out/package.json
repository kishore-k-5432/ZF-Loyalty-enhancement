{
  "name": "zom-videoiq",
  "private": true,
  "version": "0.1.0",
  "description": "ZOM-VideoIQ — the canonical design system, and the application built from it.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "canon": "storybook dev -p 6006 --no-open",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc -b && node scripts/check-boundaries.mjs",
    "lint": "eslint .",
    "canon:docs": "node scripts/gen-catalog.mjs",
    "tokens:sync": "node scripts/gen-tokens.mjs",
    "canon:build": "storybook build -o canon-static",
    "icons:sync": "node scripts/gen-icons.mjs",
    "build:catalyst": "npm run build && node scripts/build-catalyst.mjs",
    "sync": "bash scripts/sync.sh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-docs": "^10.2.10",
    "@storybook/react-vite": "^10.2.10",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.2.10",
    "globals": "^16.5.0",
    "storybook": "^10.2.10",
    "tailwindcss": "^4.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
